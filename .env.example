# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# GitHub Contents API (source of truth in production)
GITHUB_TOKEN=
GITHUB_OWNER=prestonmartinbiz-wq
GITHUB_REPO=PrestonData

# Optional comma-separated email allowlist (empty = any signed-in user)
ALLOWED_EMAILS=

# Call audio storage (optional). When set, recordings go to Vercel Blob (private).
# Without this token, audio is stored under data/call-audio/ for local/dev only.
# Production should set BLOB_READ_WRITE_TOKEN — GitHub is not used for audio binaries.
BLOB_READ_WRITE_TOKEN=

# OpenAI Whisper transcription (+ optional gpt-4o-mini summary).
# Uploads still succeed without this key; transcriptStatus will be "skipped".
OPENAI_API_KEY=
